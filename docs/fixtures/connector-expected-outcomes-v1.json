    { "id": "EO-06", "title": "Export delivery outcome unknown", "inputs": ["deliver", "deliver again", "reconcile", "deliver again"],
      "expected": { "pure": {
        "unknown_accepted": { "results": ["outcome_unknown", "outcome_unknown", "succeeded", "succeeded"], "simulatedEffects": 1 },
        "unknown_unresolved": { "results": ["outcome_unknown", "outcome_unknown", "unknown", "outcome_unknown"], "simulatedEffects": 0 },
        "unknown_not_accepted": { "results": ["outcome_unknown", "outcome_unknown", "not_found", "outcome_unknown"], "simulatedEffects": 0 } },
        "stored": { "retryOnlyAfter": "durable reconciliation shows safe non-delivery and current authority still holds" } } },
