      "expected": { "pure": {
        "afterPart": { "extraPaidGross": "300000/31", "extraPaidNet": "250000/31", "orderPaidGross": "1250000/31", "totalPaidNet": "125000/3", "q": "250000/31", "feePence": 806, "deltaPence": 806 },
        "afterBalance": { "extraPaidNet": "24000", "orderPaidNet": "100000", "totalPaidGross": "148800", "q": "24000", "feePence": 2400, "deltaPence": 1594 } } } },
    { "id": "EO-09", "title": "A credit after payment", "inputs": ["inv-1", "pay-full", "credit-ext"],
      "expected": { "pure": { "extraCreditedNet": "5000", "extraPaidNet": "24000", "q": "19000", "feePence": 1900, "priorPence": 2400, "deltaPence": -500 } } },
    { "id": "EO-10", "title": "A payment reversal", "inputs": ["inv-1", "pay-full", "reverse-full"],
      "expected": { "pure": { "totalPaidGross": "0", "extraPaidNet": "0", "q": "0", "feePence": 0, "priorPence": 2400, "deltaPence": -2400 } } },
    { "id": "EO-11", "title": "A billing rejection", "inputs": ["inv-1", "reject-ext"],
