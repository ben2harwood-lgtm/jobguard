+  expect(result.reason).toBe("Pending money cannot qualify");
+  expect(result.lines.find(l=>l.kind==="statutory_interest")?.reason).toBe("Late-payment interest only counts when a business paid it. This customer is a private individual, so this interest isn’t counted as recovered money and there’s no fee on it.");
+ });
+ it("B2: paid-before reason covers every F19 line",()=>{
+  const result=evaluateRecoveryEligibilityV3(facts("F19",{paymentTiming:"before_opening"}));
