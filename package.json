{
  "name": "jobguard",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": { "node": ">=24.0.0 <25", "pnpm": "10.28.1" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "node tools/lint.mjs && turbo run lint",
    "lint:lanes": "node tools/agent-lane-boundary-lint.mjs",
    "test": "node --test tools/*.test.mjs && turbo run test",
    "test:e2e": "pnpm --filter @jobguard/web test:e2e",
    "typecheck": "turbo run typecheck",
    "openapi:check": "pnpm --filter @jobguard/api openapi:check"
  },
  "devDependencies": { "turbo": "2.5.8", "typescript": "5.8.3" }
}
