    {
      "section": "authorityPaths",
      "before": null,
      "after": {
        "id": "ap-snag-list",
        "title": "Snag list",
        "description": "The job's snag list in practice mode. A snag is written once and each change of details is a new revision; fixed, checked and reopened are append-only events from which the state is derived, and up to six verified snag photos of the same job link to a snag once each. The runtime may only read these tables under tenant RLS. Every write goes through a SECURITY DEFINER routine that refuses any database other than the practice one, requires the bound practice credential and its own job, takes the watchdog live guard, and records the command so an exact retry replays and a reused command id conflicts. A check needs a prior fix, and comes from someone other than the fixer once another active member has worked on the job's snag list. No role may update or delete the rows. A forward migration can drop the routines while keeping the rows as site history.",
        "cards": [
          "LP-11",
          "LP-12"
        ],
        "responsibilities": {
          "LP-11": "Keep snag reads and writes bound to the request's tenant and the practice session that owns the job.",
          "LP-12": "Keep snag rows append-only, written only by the checked routines, and link only verified snag photos of the same job."
        },
        "sources": [
          "packages/db/migrations/0782_snag_list.sql",
          "packages/db/src/snag-repository.ts",
          "apps/api/src/snag.application.ts"
        ],
