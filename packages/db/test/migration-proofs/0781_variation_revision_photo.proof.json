      "section": "authorityPaths",
      "before": null,
      "after": {
        "id": "ap-variation-photos",
        "title": "Photos on variations",
        "description": "Pricing a variation revision freezes up to six verified, uninvalidated photos of that extra into immutable links. The checked customer routine shows only those photos, refuses an approval whose photo list differs, and returns one linked photo's stored object for a 60-second signed download. The runtime may only read links under tenant RLS; only the pricing trigger writes them, and no role may update or delete them. A link ties one revision, its variation, its scope item and a photo on that same job and scope item. The customer download refuses any linked object that is not a variation photo or has been invalidated. A forward migration can drop the routine and policy while keeping the links as evidence history.",
        "cards": [
          "LP-11",
          "LP-12"
        ],
        "responsibilities": {
          "LP-11": "Keep customer photo reads bound to the checked portal session, its exact job and photos frozen on a priced revision of that job.",
          "LP-12": "Keep the photo links immutable, written only by the pricing trigger, and bind customer approval to the exact frozen photo list."
        },
        "sources": [
          "packages/db/migrations/0781_variation_revision_photo.sql",
          "apps/api/src/auth/customer-variation.ts",
          "apps/api/src/workspace/pilot-job-continuation.ts",
