{
  "name": "@jobguard/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bootstrap:demo": "pnpm build && node dist/demo-bootstrap-cli.js",
    "test:regression": "vitest run --maxWorkers=1 test/activation.integration.test.ts test/quote.integration.test.ts test/tenancy.integration.test.ts test/evidence.integration.test.ts test/final-account.integration.test.ts test/recovery.integration.test.ts test/outbox.integration.test.ts"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "embedded-postgres": "16.10.0-beta.15",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3",
    "zod": "3.25.76",
    "@jobguard/storage": "workspace:*",
    "@jobguard/core": "workspace:*"
  }
}
