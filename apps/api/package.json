{
  "name": "@jobguard/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && pnpm openapi:check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "tsx src/generate-openapi.ts",
    "openapi:check": "tsx src/generate-openapi.ts --check",
    "start:worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@jobguard/config": "workspace:*",
    "@jobguard/db": "workspace:*",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "graphile-worker": "0.16.6",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.67",
    "@jobguard/ai": "workspace:*",
    "@jobguard/core": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@types/node": "24.0.3",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  }
}
