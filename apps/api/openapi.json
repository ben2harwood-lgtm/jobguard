      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Process liveness; deliberately does not access dependencies",
        "tags": [
          "system"
        ]
      }
    },
    "/jobs/capture": {
      "post": {
        "operationId": "CaptureController_capture",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "contractVersion",
                  "requested_tenant_id",
                  "captureId",
                  "source",
                  "fixtureId"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Proposal only; no canonical revision or send is created"
          }
        },
        "summary": "Create an idempotent draft job and cited proposal from synthetic text",
        "tags": [
          "jobs"
        ]
      }
    },
