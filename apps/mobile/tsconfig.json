{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "react"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "App.tsx",
    "src/**/*.ts"
  ]
}
